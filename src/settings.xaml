<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" TabFocusNavigation="Cycle" Padding="24,18,24,20">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="新标签页" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="默认打开位置" Style="{StaticResource BodyTextBlockStyle}" Margin="0,20,0,4" />
        <RadioButton x:Name="ThisPC" Content="此电脑" GroupName="Location" />
        <RadioButton x:Name="QuickAccess" Content="快速访问" GroupName="Location" />
        <TextBlock Text="快捷键" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,4" />
        <TextBlock x:Name="ShortcutHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,0,6" />
        <StackPanel x:Name="Shortcuts" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="Save" Content="确定" MinWidth="80" />
            <Button x:Name="Cancel" Content="取消" MinWidth="80" Margin="8,0,0,0" />
            <Button x:Name="Reset" Content="重置默认值" Margin="16,0,0,0" />
    </StackPanel>
</Grid>
